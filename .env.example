# Robinhood Account Credentials
ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password

# Optional: TOTP secret key for automatic 2FA code generation
# Obtain this in Robinhood app/web: Settings -> Security -> Two-Factor Authentication -> Authenticator App -> Can't scan barcode / Manual Key
# If left blank, you will be prompted interactively in the terminal for the SMS or verification challenge.
ROBINHOOD_MFA_SECRET=
